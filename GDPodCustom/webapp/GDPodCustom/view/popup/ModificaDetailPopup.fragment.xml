<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:t="sap.ui.table">
    <Dialog title="Dettaglio Modifica" contentWidth="70%" contentHeight="60%" draggable="true" resizable="true">
        
        <VBox class="sapUiMediumMargin">
            <!-- HEADER INFO -->
            <Panel expandable="false" class="sapUiResponsiveMargin">
                <headerToolbar>
                    <Toolbar>
                        <Title text="{i18n>modifiche.detail.title}" level="H2" class="detailTableTitle"/>
                    </Toolbar>
                </headerToolbar>

                <l:Grid defaultSpan="L3 M6 S12" hSpacing="2" vSpacing="1">

                    <VBox>
                        <Label text="{i18n>modifiche.detail.project}" class="detailHeaderLabel"/>
                        <Text text="{detailModificaModel>/header/project}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.wbe}" class="detailHeaderLabel"/>
                        <Text text="{detailModificaModel>/header/wbe}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.machine_section}" class="detailHeaderLabel"/>
                        <Text text="{detailModificaModel>/header/machine_section}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.material}" class="detailHeaderLabel" />
                        <Text text="{detailModificaModel>/header/material}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.prcoess_id}" class="detailHeaderLabel" />
                        <Text text="{detailModificaModel>/header/process_id}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.type}" class="detailHeaderLabel" />
                        <Text text="{detailModificaModel>/header/type}" class="detailHeaderValue" />
                    </VBox>

                    <VBox>
                        <Label text="{i18n>modifiche.detail.variance}" class="detailHeaderLabel" />
                        <Text text="{detailModificaModel>/header/variance}" class="detailHeaderValue" />
                    </VBox>

                </l:Grid>
            </Panel>

            <!-- TABELLE AFFIANCATE -->
            <HBox width="100%" class="sapUiMediumMarginTop" renderType="Bare">
                <!-- DA INSERIRE -->
                <VBox width="50%" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                    <Title text="{i18n>modifiche.detail.table.insert}"  level="H3" class="detailTableTitle"/>
                    <Table items="{detailModificaModel>/rows}">
                        <columns>
                            <Column><Text text="{i18n>modifiche.detail.table.progressive}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.child_material}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.description}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.qty}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detailModificaModel>progressive}" class="detailTableText" />
                                    <Text text="{detailModificaModel>right/child_material}" class="detailTableText" />
                                    <Text text="{detailModificaModel>right/child_material_description}" class="detailTableText" />
                                    <Text text="{detailModificaModel>right/qty}" class="detailTableText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
                <!-- DA ANNULLARE -->
                <VBox width="50%" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                    <Title text="{i18n>modifiche.detail.table.delete}" level="H3" class="detailTableTitle"/>
                    <Table items="{detailModificaModel>/rows}">
                        <columns>
                            <Column><Text text="{i18n>modifiche.detail.table.child_material}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.description}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.qty}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detailModificaModel>left/child_material}" class="detailTableText" />
                                    <Text text="{detailModificaModel>left/child_material_description}" class="detailTableText" />
                                    <Text text="{detailModificaModel>left/qty}" class="detailTableText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </HBox>

            <VBox width="100%" class="sapUiMediumMarginTop" renderType="Bare" >
                <Title text="{i18n>modifiche.detail.table.qtyToChange}"  level="H3" class="detailTableTitle"/>
                    <Table items="{detailModificaModel>/mRows}">
                        <columns>
                            <Column><Text text="{i18n>modifiche.detail.table.child_material}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.description}"/></Column>
                            <Column><Text text="{i18n>modifiche.detail.table.qty}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detailModificaModel>child_material}" class="detailTableText" />
                                    <Text text="{detailModificaModel>child_material_description}" class="detailTableText" />
                                    <Text text="{detailModificaModel>qty}" class="detailTableText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
            </VBox>

        </VBox>

        <beginButton>
            <Button text="Chiudi" press="onCloseDettaglio"/>
        </beginButton>

    </Dialog>

</core:FragmentDefinition>